# Copiar como .env (archivo excluido de Git) y completar con el cliente OAuth de la API Java.
# Estas variables las lee solo el servidor de Vite; no llegan al navegador (no usan el prefijo VITE_).
OAUTH_CLIENT_ID=<cliente-oauth>
OAUTH_CLIENT_SECRET=<secreto-del-cliente>

# Punto de entrada REST (NGINX). Opcional: por defecto http://127.0.0.1:8090
API_BASE_URL=http://127.0.0.1:8090
