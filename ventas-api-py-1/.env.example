#Conexion a base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vehiculos
DB_USER=root
DB_PASSWORD=

#url del api de java
JAVA_URL=http://127.0.0.1:8086

# Debe coincidir con app.security.ventas-key de la API Java (>= 32 caracteres)
VENTAS_SERVICE_KEY=cambiar-esto

#URL API DE NOTIFICACIONES
NOTIFICACIONES_URL=http://127.0.0.1:8088
# Debe coincidir con servicios.notificaciones.key / app.notificacion-key
NOTIFICACIONES_KEY=cambiar-esto

# RabbitMQ (Actividad 8): usuario y contraseña del broker
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=<usuario-rabbitmq>
RABBITMQ_PASSWORD=<contrasena-rabbitmq>
RABBITMQ_COLA_VENTAS=notificaciones.ventas

# Debe ser igual a app.security.jwt-secret de la API Java (>= 32 caracteres)
JWT_SECRET=<clave-de-firma-del-jwt>
